# ===========================================================================
# Dayflow HRMS - configuration template
#
# Copy this file to ".env" and fill in every value marked REQUIRED:
#
#     copy .env.example .env          (Windows)
#     cp   .env.example .env          (macOS / Linux)
#
# Then generate the secrets:
#
#     powershell -File scripts/generate-secrets.ps1
#     bash scripts/generate-secrets.sh
#
# ".env" is listed in .gitignore and must never be committed.
#
# NOTE: comments must always sit on their own line in this file. A "#" placed
# after a value would be read as part of that value.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=Dayflow
# local | staging | production
APP_ENV=local
# Never true in production: it turns on detailed error messages.
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# --- Published ports -------------------------------------------------------
WEB_PORT=8000
GATEWAY_PORT=8080
ADMINER_PORT=8081
POSTGRES_PORT=5432

# --- Database --------------------------------------------------------------
POSTGRES_DB=dayflow
POSTGRES_USER=dayflow_owner
# REQUIRED. Long random value.
POSTGRES_PASSWORD=
# REQUIRED. Shared by the nine per-service database roles.
DAYFLOW_DB_SERVICE_PASSWORD=

# --- Cryptographic secrets -------------------------------------------------
# All three are REQUIRED and must be at least 32 characters.
# Generate them; never invent them by hand.
# Signs the access tokens issued at sign-in.
JWT_SECRET=
# Signs every gateway-to-service call so services refuse anything else.
INTERNAL_SIGNING_KEY=
# Encrypts bank and tax details at rest.
ENCRYPTION_KEY=

JWT_ISSUER=dayflow.identity
JWT_AUDIENCE=dayflow.api

# --- Sessions and tokens ---------------------------------------------------
# Access token lifetime in seconds (15 minutes).
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in seconds (7 days).
REFRESH_TOKEN_TTL=604800
# Sign out after this many seconds of inactivity (30 minutes).
SESSION_IDLE_TIMEOUT=1800
# Sign out after this long regardless of activity (8 hours).
SESSION_ABSOLUTE_TIMEOUT=28800
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

# --- Sign-in protection ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
# When true, services reject any request that did not come through the gateway.
REQUIRE_GATEWAY_SIGNATURE=true
CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- The first administrator account ---------------------------------------
# Created automatically the first time the identity service starts.
SEED_ADMIN_EMAIL=admin@example.com
# REQUIRED.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator

# Populates departments, employees, leave types, courses and sample records so
# the dashboards have something to show. Set to false for a clean deployment.
SEED_DEMO_DATA=true

# --- Email -----------------------------------------------------------------
# "log"  - writes messages to storage/mail and shows them at /mailbox
# "smtp" - sends for real using the settings below
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@dayflow.local
MAIL_FROM_NAME=Dayflow HR
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# --- Money -----------------------------------------------------------------
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
